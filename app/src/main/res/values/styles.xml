<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 26 使用深色导航栏保证白色图标清晰；API 27+ 的浅色导航栏见 values-v27。
         页面内容通过 Ui.insets() 避让系统栏与刘海。 -->
    <style name="AppThemeBase" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#007068</item>
        <item name="android:windowBackground">#F2F7F6</item>
        <item name="android:statusBarColor">#F2F7F6</item>
        <item name="android:navigationBarColor">#183437</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
</resources>